    "notes": "Search syntax and indexing vary by provider."
  },
  {
    "id": "exact-phrase",
    "name": "Exact Phrase",
    "template": "\"{phrase}\"",
    "fields": [
      {
        "name": "phrase",
        "label": "Phrase",
        "placeholder": "project name"
      }
    ],
    "example": "\"project name\"",
    "purpose": "Generate a structured public-web query.",
    "notes": "Search syntax and indexing vary by provider."
  },
  {
    "id": "site-exclusion",
    "name": "Site + Exclusion",
    "template": "site:{domain} {keyword} -{exclude}",
    "fields": [
      {
        "name": "domain",
        "label": "Domain",
        "placeholder": "example.org"
      },
      {
        "name": "keyword",
        "label": "Keyword",
        "placeholder": "documentation"
      },
      {
        "name": "exclude",
        "label": "Exclude term",
        "placeholder": "jobs"
      }
    ],
    "example": "site:example.org documentation -jobs",
    "purpose": "Reduce a common category of irrelevant indexed results.",
    "notes": "Exclusion behavior varies by search engine."
  },
  {
    "id": "file-phrase",
    "name": "File Type + Exact Phrase",
    "template": "filetype:{extension} \"{phrase}\"",
    "fields": [
      {
        "name": "extension",
        "label": "Extension",
        "placeholder": "pdf"
      },
      {
        "name": "phrase",
        "label": "Phrase",
        "placeholder": "technical specification"
      }
    ],
    "example": "filetype:pdf \"technical specification\"",
    "purpose": "Search public indexed files containing an exact phrase.",
    "notes": "Not restricted to one domain."
  },
  {
    "id": "site-two-terms",
    "name": "Site + Two Terms",
    "template": "site:{domain} \"{term_a}\" \"{term_b}\"",
    "fields": [
      {
        "name": "domain",
        "label": "Domain",
        "placeholder": "example.org"
      },
      {
        "name": "term_a",
        "label": "Term A",
        "placeholder": "security"
      },
      {
        "name": "term_b",
        "label": "Term B",
        "placeholder": "policy"
      }
    ],
    "example": "site:example.org \"security\" \"policy\"",
    "purpose": "Require two distinct phrases within indexed results.",
    "notes": "Useful for reducing broad keyword noise."
  },
  {
    "id": "site-language",
    "name": "Site + Language",
    "template": "site:{domain} {keyword} lang:{language}",
    "fields": [
      {
        "name": "domain",
        "label": "Domain",
        "placeholder": "example.org"
      },
      {
        "name": "keyword",
        "label": "Keyword",
        "placeholder": "documentation"
      },
      {
        "name": "language",
        "label": "Language code",
        "placeholder": "en"
      }
    ],
    "example": "site:example.org documentation lang:en",
    "purpose": "Combine a site constraint with a language filter where supported.",
    "notes": "Language filtering is provider-dependent."
  }
]
