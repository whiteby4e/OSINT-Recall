[
  {
    "id": "site-filetype",
    "name": "Site + File Type",
    "template": "site:{domain} {keyword} filetype:{extension}",
    "fields": [
      {
        "name": "domain",
        "label": "Domain",
        "placeholder": "example.org"
      },
      {
        "name": "keyword",
        "label": "Keyword",
        "placeholder": "documentation"
      },
      {
        "name": "extension",
        "label": "Extension",
        "placeholder": "pdf"
      }
    ],
    "example": "site:example.org documentation filetype:pdf",
    "purpose": "Generate a structured public-web query.",
    "notes": "Search syntax and indexing vary by provider."
  },
  {
    "id": "site-title",
