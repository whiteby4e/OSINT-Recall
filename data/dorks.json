      {
        "name": "domain",
        "label": "Domain",
        "placeholder": "example.org"
      },
      {
        "name": "keyword",
        "label": "URL keyword",
        "placeholder": "docs"
      }
    ],
    "example": "site:example.org inurl:docs",
